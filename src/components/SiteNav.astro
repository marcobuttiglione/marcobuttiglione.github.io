---
import { LINKS } from '../consts';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const items = [
	{ href: '/projects', label: 'Projects' },
	{ href: '/publications', label: 'Publications' },
];
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<nav class="site-nav" aria-label="Main">
	<a href="/" class="logo" aria-label="Home">mdb<span>.</span></a>
	{items.map((item) => (
		<a href={item.href} class:list={['l', { on: isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
	))}
	<a href={LINKS.cv} class="l cta" download>CV</a>
	<button class="theme" id="theme-toggle" type="button" aria-label="Toggle dark mode">
		<svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg>
		<svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" /></svg>
	</button>
</nav>

<style>
	.site-nav { position: sticky; top: 1rem; z-index: 50; margin: 1rem auto 0; width: fit-content; max-width: calc(100vw - 1rem); display: flex; align-items: center; gap: 0.2rem; padding: 0.35rem 0.35rem 0.35rem 1rem; background: rgba(20, 21, 24, 0.9); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.06); border-radius: 99px; box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12); }
	.logo { font-family: var(--mono); color: #fff; font-size: 0.85rem; margin-right: 0.8rem; }
	.logo span { color: var(--accent); }
	.l { color: #d8d9de; font-size: 0.9rem; font-weight: 500; padding: 0.5rem 0.95rem; border-radius: 99px; transition: background 0.2s, color 0.2s; white-space: nowrap; }
	.l:hover, .l.on { background: rgba(255, 255, 255, 0.1); color: #fff; }
	.l.cta { background: var(--accent); color: #fff; }
	.l.cta:hover { background: var(--accent-hover); }
	.theme { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; margin-left: 0.15rem; border: 0; border-radius: 50%; background: transparent; color: #d8d9de; cursor: pointer; transition: background 0.2s, color 0.2s; }
	.theme:hover { background: rgba(255, 255, 255, 0.1); color: #fff; }
	.theme svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
	.theme .sun, :global([data-theme='dark']) .theme .moon { display: none; }
	:global([data-theme='dark']) .theme .sun { display: block; }

	@media (max-width: 560px) {
		.site-nav { padding-left: 0.8rem; }
		.logo { margin-right: 0.3rem; }
		.l { padding: 0.5rem 0.65rem; font-size: 0.85rem; }
	}
</style>

<script>
	// The theme is applied before paint by the inline script in BaseHead
	document.getElementById('theme-toggle')?.addEventListener('click', () => {
		const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
		document.documentElement.setAttribute('data-theme', next);
		localStorage.setItem('theme', next);
	});
</script>
